[Unit]
Description=LPanel 服务器管理面板
After=network-online.target nginx.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lpanel
Environment=TMPDIR=/opt/lpanel/.tmp
ExecStart=/opt/lpanel/current/lpanel serve --root /opt/lpanel
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
